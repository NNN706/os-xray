<form>
  <field>
    <type>header</type>
    <label>Profile</label>
  </field>
  <field>
    <id>instance.enabled</id>
    <label>Enabled</label>
    <type>checkbox</type>
  </field>
  <field>
    <id>instance.name</id>
    <label>Name</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.config_json</id>
    <label>Full configuration (JSON)</label>
    <type>textbox</type>
    <help>Full Xray JSON. Save prepares it; Apply or reconnect activates it.</help>
  </field>
  <field>
    <id>instance.use_config_dns</id>
    <label>Use DNS from configuration</label>
    <type>checkbox</type>
    <help>Only affects the Xray runtime copy; system DNS is unchanged.</help>
  </field>
  <field>
    <id>instance.socks_inbound</id>
    <label>SOCKS inbound</label>
    <type>text</type>
    <help>Use an existing loopback SOCKS inbound. No inbound is silently created.</help>
  </field>
  <field>
    <type>header</type>
    <label>Tunnel</label>
  </field>
  <field>
    <id>instance.tun_interface</id>
    <label>TUN interface</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.mtu</id>
    <label>MTU</label>
    <type>text</type>
  </field>
  <field>
    <type>header</type>
    <label>Subscription</label>
  </field>
  <field>
    <id>instance.subscription_url</id>
    <label>Subscription URL</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.auto_update</id>
    <label>Auto Update Subscription</label>
    <type>checkbox</type>
  </field>
  <field>
    <id>instance.update_mode</id>
    <label>Update interval</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.update_hours</id>
    <label>Manual interval</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.subscription_remarks</id>
    <label>subscription_remarks</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.subscription_metadata</id>
    <label>subscription_metadata</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.subscription_baseline</id>
    <label>subscription_baseline</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.subscription_hash</id>
    <label>subscription_hash</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.subscription_fetched</id>
    <label>subscription_fetched</label>
    <type>text</type>
  </field>
  <field>
    <type>header</type>
    <label>Health check / Heartbeat</label>
  </field>
  <field>
    <id>instance.health_enabled</id>
    <label>Enable heartbeat</label>
    <type>checkbox</type>
    <help>Cloudflare generate_204 via the applied SOCKS; expected HTTP 204, timeout 2000 ms. No changes to Xray Routing.</help>
  </field>
  <field>
    <id>instance.health_interval</id>
    <label>Check interval</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.health_bypass</id>
    <label>Automatic WAN bypass</label>
    <type>checkbox</type>
    <help>One failed check switches enrolled traffic to WAN. Three successful checks restore TUN. Xray BLOCK rules do not apply while bypassing; firewall rules remain effective.</help>
  </field>
  <field>
    <type>header</type>
    <label>Managed traffic (optional)</label>
  </field>
  <field>
    <id>instance.routing_mode</id>
    <label>Traffic mode</label>
    <type>text</type>
    <help>Off leaves firewall rules unmanaged. All routes traffic selected by enrolled rules. ASN / CIDR limits their destination at the router; Xray Routing still processes tunnel traffic.</help>
  </field>
  <field>
    <id>instance.routing_rules</id>
    <label>Enrolled firewall rules</label>
    <type>text</type>
    <help>Comma-separated UUIDs or tracker:NUMBER identifiers of enabled client-side IPv4/IPv6 pass rules whose descriptions start with [os-xray]. Create these rules in OPNsense, in the desired order, with destination any and an existing TUN gateway. Only these rules are managed.</help>
  </field>
  <field>
    <id>instance.routing_cidrs</id>
    <label>Destination CIDRs</label>
    <type>textbox</type>
  </field>
  <field>
    <id>instance.routing_asns</id>
    <label>Destination ASNs</label>
    <type>text</type>
    <help>Announced prefixes are fetched from RIPEstat on Apply. No BGP daemon or DNS changes. ASN is not proof of exclusive ownership of an address.</help>
  </field>
  <field>
    <id>instance.routing_tun4</id>
    <label>Existing TUN gateway (IPv4)</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.routing_wan4</id>
    <label>Existing WAN gateway (IPv4)</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.routing_tun6</id>
    <label>Existing TUN gateway (IPv6)</label>
    <type>text</type>
  </field>
  <field>
    <id>instance.routing_wan6</id>
    <label>Existing WAN gateway (IPv6)</label>
    <type>text</type>
  </field>
</form>